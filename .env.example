# Dualis Creative
#
# URL publica absoluta do site.
#
# Desenvolvimento:
NEXT_PUBLIC_SITE_URL=https://dualiscreative.com.br

# Em producao, configure:
#
# NEXT_PUBLIC_SITE_URL=https://dualiscreative.com.br

# Refinamento facial em runtime.
# false = usa somente focus editorial pré-calculado.
# true  = ativa MediaPipe no navegador.
NEXT_PUBLIC_ENABLE_FACE_TRACKING=false
